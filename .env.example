POSTGRES_PASSWORD=xxxxxxx

MONGO_INITDB_ROOT_USERNAME=sgmb_user
MONGO_INITDB_ROOT_PASSWORD=xxxxxxx



# NOTA: COMO MODIFICAR ESTE ARCHIVO
# DB_PASSWORD=xxxxxxxx  ==> PASS Q CORRESPONDA
# RENOMBRAR EL ARCHIVO ==> .env