# ==========================================
# DJANGO BACKEND CONFIGURATION
# ==========================================
SECRET_KEY=django-insecure-cambia_esta_clave_por_una_segura_en_produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,sgmb_backend

# Orígenes permitidos para Angular
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ==========================================
# POSTGRESQL CONFIGURATION
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sgmb_db

# ==========================================
# MONGODB CONFIGURATION
# ==========================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=adminpassword
MONGO_DB_NAME=sgmb_db
MONGO_HOST=mongo_nuevo_proyecto
MONGO_PORT=27017

# ==========================================
# MONGO EXPRESS CONFIGURATION
# ==========================================
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=adminpassword
ME_CONFIG_MONGODB_SERVER=mongo_nuevo_proyecto
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=pass
