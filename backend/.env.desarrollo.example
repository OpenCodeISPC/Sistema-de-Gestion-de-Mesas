S# ==========================================
# CONFIGURACIÓN DE DJANGO (ENTORNO DESARROLLO)
# ==========================================
DEBUG=True
SECRET_KEY=

# Hosts permitidos en desarrollo
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# BASE DE DATOS PRINCIPAL: POSTGRESQL (DOCKER)
# ==========================================
# Usados por el contenedor de Postgres y la app Django
POSTGRES_USER=sgmb_user
POSTGRES_PASSWORD=
POSTGRES_DB=sgmb_db

# Variables de conexión interna para Django dentro de Docker
DB_NAME=sgmb_db
DB_USER=sgmb_user
DB_PASSWORD=
DB_HOST=postgres_nuevo_proyecto
DB_PORT=5432

# ==========================================
# BASE DE DATOS NOSQL: MONGODB (DOCKER)
# ==========================================
# Usados por el contenedor de Mongo
MONGO_INITDB_ROOT_USERNAME=sgmb_user
MONGO_INITDB_ROOT_PASSWORD=

# URI de conexión interna para Django dentro de Docker
MONGO_URI=
MONGO_DB_NAME=sgmb_mongo_db

# ==========================================
# CONFIGURACIONES ADICIONALES (CORS / FRONTEND)
# ==========================================
# Para permitir peticiones desde Angular local (http://localhost:4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ==========================================
# REDIS (DJANGO CHANNELS / WEBSOCKETS)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==========================================
# Google
# ==========================================
GOOGLE_CLIENT_ID=434100213711-r1r7inb8ojtohebcffff5e9grquki8aq.apps.googleusercontent.com

# =====================================
# EMAIL / OTP (BREVO VIA API HTTP)
# =====================================
# Para enviar emails reales con Brevo (requiere BREVO_API_KEY), usar:
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SGMB <tu-sender-verificado@gmail.com>
BREVO_API_KEY=
OTP_EXPIRACION_MINUTOS=10
